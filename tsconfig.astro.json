{
  // The astronomy must not depend on the DOM, Node or the renderer,
  // so it is checked with only the ES library and no ambient types.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src/astro/**/*.ts"],
  "exclude": ["src/astro/__tests__/**"]
}
